<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvNombreStock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                tools:text="Maíz Grano" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarStock"
                style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconPadding="0dp" />
        </LinearLayout>

        <!-- Información de stock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cantidad Disponible"
                    android:textAppearance="@style/TextAppearance.Dietasapp.Body2" />

                <TextView
                    android:id="@+id/tvCantidadStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                    android:textColor="@color/primary_blue"
                    tools:text="1500 kg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Valor"
                    android:textAppearance="@style/TextAppearance.Dietasapp.Body2" />

                <TextView
                    android:id="@+id/tvValorStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                    tools:text="$330.00" />
            </LinearLayout>
        </LinearLayout>

        <!-- Barra de progreso visual -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            tools:progress="75" />

        <!-- Última actualización -->
        <TextView
            android:id="@+id/tvUltimaActualizacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
            tools:text="Actualizado: 06/10/2025 14:30" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>