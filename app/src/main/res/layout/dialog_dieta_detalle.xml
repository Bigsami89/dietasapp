<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        app:titleTextColor="@color/white"
        app:navigationIconTint="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card: Información General -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/informacion_general"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:layout_marginBottom="12dp" />

                    <!-- Animal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="@string/animal"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tvNombreAnimal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                            tools:text="Vaca Holstein" />
                    </LinearLayout>

                    <!-- Fecha -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="@string/fecha"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tvFechaCreacion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                            tools:text="10/10/2025 14:30" />
                    </LinearLayout>

                    <!-- Modo optimización -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="@string/modo_optimizacion"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tvModoOptimizacion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                            tools:text="Minimizar Costo" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Resumen de Costos -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/resumen_economico"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:layout_marginBottom="12dp" />

                    <!-- Costo Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_attach_money"
                            android:tint="@color/accent_green"
                            android:layout_marginEnd="8dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/costo_total_diario"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                                android:textColor="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/tvCostoTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                                android:textColor="@color/accent_green"
                                tools:text="$125.50 MXN/día" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Emisiones de Metano -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_eco"
                            android:tint="@color/accent_blue"
                            android:layout_marginEnd="8dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/emisiones_metano"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                                android:textColor="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/tvMetanoTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Headline3"
                                android:textColor="@color/accent_blue"
                                tools:text="245.3 g CH₄/día" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Composición de la Dieta -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/composicion_dieta"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvComposicion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_composicion" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Información Nutricional -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/informacion_nutricional"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:textSize="24sp"
                        android:layout_marginBottom="16dp" />

                    <!-- Grid fila 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <!-- Materia Seca -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:minHeight="56dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/materia_seca"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Caption"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textAlignment="center"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvMateriaSecaTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Headline3"
                                android:textSize="26sp"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="16sp"
                                android:autoSizeMaxTextSize="26sp"
                                android:autoSizeStepGranularity="1sp"
                                tools:text="18.5 kg" />
                        </LinearLayout>

                        <!-- Proteína Cruda -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:minHeight="56dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/proteina_cruda"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Caption"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textAlignment="center"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvProteinaCruda"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Headline3"
                                android:textSize="26sp"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="16sp"
                                android:autoSizeMaxTextSize="26sp"
                                android:autoSizeStepGranularity="1sp"
                                tools:text="2.8 %" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Grid fila 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Energía -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:minHeight="56dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/energia_neta"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Caption"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textAlignment="center"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvEnergia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Headline3"
                                android:textSize="26sp"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="16sp"
                                android:autoSizeMaxTextSize="26sp"
                                android:autoSizeStepGranularity="1sp"
                                tools:text="32.5 Mcal" />
                        </LinearLayout>

                        <!-- Fibra -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:minHeight="56dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fibra_fdn"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Caption"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textAlignment="center"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvFibra"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Dietasapp.Headline3"
                                android:textSize="26sp"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="16sp"
                                android:autoSizeMaxTextSize="26sp"
                                android:autoSizeStepGranularity="1sp"
                                tools:text="6.2 %" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- Card: Requerimientos del Animal -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/requerimientos_animal"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:layout_marginBottom="12dp" />

                    <!-- Peso -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:text="@string/peso"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tvPesoAnimal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                            tools:text="650 kg" />
                    </LinearLayout>

                    <!-- Producción de Leche -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:text="@string/produccion_leche"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tvProduccionLeche"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                            tools:text="25 kg/día" />
                    </LinearLayout>

                    <!-- Ganancia de Peso -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:text="@string/ganancia_peso"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tvGananciaPeso"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                            tools:text="0.8 kg/día" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>