<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calcular_dieta_titulo"
            android:textAppearance="@style/TextAppearance.Dietasapp.Headline1"
            android:layout_marginBottom="24dp" />

        <!-- Card: Selección de Animal -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAnimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/seleccionar_animal"
                    android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/spinnerAnimalLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/seleccionar_animal">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerAnimal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Info del animal seleccionado -->
                <LinearLayout
                    android:id="@+id/layoutInfoAnimal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvPesoAnimal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                        tools:text="Peso: 650 kg" />

                    <TextView
                        android:id="@+id/tvDMIAnimal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                        tools:text="DMI: 22 kg/día" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Modo de Optimización -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardModo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/modo_optimizacion"
                    android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/radioGroupModo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioMinimizarCosto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/minimizar_costo"
                        android:checked="true" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioMinimizarMetano"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/minimizar_metano" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Calcular -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/calcular_button"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_calculator"
            app:iconGravity="start"
            android:layout_marginBottom="16dp" />

        <!-- Progress Indicator -->
        <LinearLayout
            android:id="@+id/layoutCalculando"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calculando"
                android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- Resultado de la Dieta -->
        <LinearLayout
            android:id="@+id/layoutResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/resultado_dieta"
                android:textAppearance="@style/TextAppearance.Dietasapp.Headline1"
                android:layout_marginBottom="16dp" />

            <!-- Card: Resumen Económico -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Resumen Económico"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvCostoTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                        tools:text="Costo Total: $45.50/día" />

                    <TextView
                        android:id="@+id/tvCostoPorKg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                        tools:text="Costo por kg MS: $2.07/kg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Impacto Ambiental -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/impacto_ambiental"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvMetano"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                        tools:text="Metano: 245.8 g/día" />

                    <TextView
                        android:id="@+id/tvMetanoPorKg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                        tools:text="Metano por kg DMI: 11.2 g/kg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Composición -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/composicion_dieta"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerComposicion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_ingrediente" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botones de acción -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportar"
                    style="@style/Widget.Dietasapp.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exportar_excel"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guardar_dieta" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_calculator"
                android:alpha="0.3"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sin_animales"
                android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                android:textAlignment="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agregar_animal_primero"
                android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                android:textAlignment="center" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>