<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card: Selección de Animal -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAnimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/seleccionar_animal"
                    android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/spinnerAnimalLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Animal">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerAnimal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Selección de Ingredientes -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIngredientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/seleccionar_ingredientes"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeleccionarTodos"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/seleccionar_todos"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvIngredientesSeleccionados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ingredientes_seleccionados_none"
                    android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvIngredientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="300dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_ingrediente_seleccionable"
                    tools:itemCount="5" />

                <TextView
                    android:id="@+id/tvSinIngredientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sin_ingredientes_inventario"
                    android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                    android:textAlignment="center"
                    android:padding="24dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Modo de Optimización -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOptimizacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/modo_optimizacion"
                    android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rgOptimizacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbMinimizarCosto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/minimizar_costo"
                        android:checked="true" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbMinimizarMetano"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/minimizar_metano" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Calcular -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calcular_button"
            android:textSize="16sp"
            android:paddingVertical="16dp"
            android:layout_marginBottom="16dp"
            app:icon="@drawable/ic_calculator"
            app:iconGravity="textStart" />

        <!-- Layout: Calculando (Progress) -->
        <LinearLayout
            android:id="@+id/layoutCalculando"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calculando"
                android:textAppearance="@style/TextAppearance.Dietasapp.Body1" />
        </LinearLayout>

        <!-- Layout: Resultado -->
        <LinearLayout
            android:id="@+id/layoutResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/resultado_dieta"
                android:textAppearance="@style/TextAppearance.Dietasapp.Headline1"
                android:layout_marginBottom="16dp" />

            <!-- Card: Resumen Económico -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#E3F2FD">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💰 Resumen Económico"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvCostoTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                        android:layout_marginBottom="4dp"
                        tools:text="Costo total: $15.50/día" />

                    <TextView
                        android:id="@+id/tvCostoPorKg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                        tools:text="Costo por kg MS: $1.29/kg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Impacto Ambiental -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#E8F5E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌍 Impacto Ambiental"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvMetano"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                        tools:text="Metano: 250 g/día" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Análisis y Recomendaciones (NUEVO) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAnalisis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFF3E0"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📋 Análisis y Recomendaciones"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvAnalisis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Body1"
                        tools:text="La dieta no cubre los requerimientos de proteína. Se sugiere agregar Harina de Soya." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Composición -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/composicion_dieta"
                        android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvComposicion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_composicion"
                        tools:itemCount="4" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botones de Acción -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportar"
                    style="@style/Widget.Dietasapp.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exportar_excel"
                    android:layout_marginEnd="8dp"
                    app:icon="@drawable/ic_export"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guardar_dieta"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_calculator"
                android:alpha="0.3"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sin_animales"
                android:textAppearance="@style/TextAppearance.Dietasapp.Headline2"
                android:textAlignment="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agregar_animal_primero"
                android:textAppearance="@style/TextAppearance.Dietasapp.Body2"
                android:textAlignment="center" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>