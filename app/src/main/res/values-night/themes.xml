<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema oscuro con colores azulados -->
    <style name="Theme.Dietasapp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Colores primarios -->
        <item name="colorPrimary">@color/primary_blue_light</item>
        <item name="colorPrimaryVariant">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/black</item>
        
        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/secondary_teal_light</item>
        <item name="colorSecondaryVariant">@color/secondary_teal</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Colores de fondo y superficie -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        
        <!-- Colores de error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/black</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">false</item>
        
        <!-- Estilos de componentes -->
        <item name="chipStyle">@style/Widget.Dietasapp.Chip.Dark</item>
        <item name="cardViewStyle">@style/Widget.Dietasapp.CardView.Dark</item>
        <item name="materialButtonStyle">@style/Widget.Dietasapp.Button.Dark</item>
        <item name="textInputStyle">@style/Widget.Dietasapp.TextInputLayout.Dark</item>
    </style>
    
    <!-- Estilos de componentes para modo oscuro -->
    <style name="Widget.Dietasapp.CardView.Dark" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background_dark</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
    </style>
    
    <style name="Widget.Dietasapp.Button.Dark" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/primary_blue_light</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="Widget.Dietasapp.TextInputLayout.Dark" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_blue_light</item>
        <item name="hintTextColor">@color/primary_blue_light</item>
        <item name="android:textColorHint">@color/text_secondary_dark</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>
    
    <style name="Widget.Dietasapp.Chip.Dark" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/primary_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipCornerRadius">16dp</item>
    </style>
    
    <!-- Estilos de texto para modo oscuro -->
    <style name="TextAppearance.Dietasapp.Headline1" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.Dietasapp.Headline2" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.Dietasapp.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">16sp</item>
    </style>
    
    <style name="TextAppearance.Dietasapp.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>